{
  "ConnectionStrings": {
    "LifeLinkConnection": "Server=localhost;Database=LifeLinkDb;Trusted_Connection=True;TrustServerCertificate=True;"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
    "JwtSettings": {
      "SecretKey": "<stored-in-user-secrets>",
      "Issuer": "LifeLink",
      "Audience": "LifeLinkClient",
      "ExpirationMinutes": 15
    },
  "AllowedHosts": "*"
}