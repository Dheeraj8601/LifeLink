  "components": {
    "schemas": {
      "CreateBloodRequestRequest": {
        "required": [
          "bloodGroup",
          "cityId",
          "hospitalAddress",
          "hospitalName",
          "urgency"
        ],
        "type": "object",
        "properties": {
          "cityId": {
            "maximum": 2147483647,
            "minimum": 1,
            "type": "integer",
            "format": "int32"
          },
          "bloodGroup": {
            "minLength": 1,
            "pattern": "^(A\\+|A-|B\\+|B-|AB\\+|AB-|O\\+|O-)$",
            "type": "string"
          },
          "hospitalName": {
            "maxLength": 200,
            "minLength": 2,
            "type": "string"
          },
          "hospitalAddress": {
            "maxLength": 500,
            "minLength": 5,
            "type": "string"
          },
          "latitude": {
            "type": "number",
            "format": "double",
            "nullable": true
          },
          "longitude": {
            "type": "number",
            "format": "double",
            "nullable": true
          },
          "unitsRequired": {
            "maximum": 100,
            "minimum": 1,
            "type": "integer",
            "format": "int32"
          },
          "urgency": {
            "minLength": 1,
            "pattern": "^(Normal|Urgent|Critical)$",
            "type": "string"
          },
          "description": {
            "maxLength": 1000,
            "minLength": 0,
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "LoginRequest": {
        "required": [
          "email",
          "password"
        ],
        "type": "object",
        "properties": {
          "email": {
            "minLength": 1,
            "type": "string",
            "format": "email"
          },
          "password": {
            "minLength": 1,
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "RegisterDonorRequest": {
        "required": [
          "bloodGroup",
          "email",
          "fullName",
          "password",
          "phoneNumber"
        ],
        "type": "object",
        "properties": {
          "fullName": {
            "maxLength": 100,
            "minLength": 2,
            "type": "string"
          },
          "email": {
            "minLength": 1,
            "type": "string",
            "format": "email"
          },
          "password": {
            "minLength": 8,
            "type": "string"
          },
          "phoneNumber": {
            "minLength": 1,
            "type": "string",
            "format": "tel"
          },
          "cityId": {
            "maximum": 2147483647,
            "minimum": 1,
            "type": "integer",
            "format": "int32"
          },
          "bloodGroup": {
            "minLength": 1,
            "pattern": "^(A\\+|A-|B\\+|B-|AB\\+|AB-|O\\+|O-)$",
            "type": "string"
          },
          "latitude": {
            "type": "number",
            "format": "double",
            "nullable": true
          },
          "longitude": {
            "type": "number",
            "format": "double",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "UpdateDonorAvailabilityRequest": {
        "type": "object",
        "properties": {
          "isAvailable": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      },
      "UpdateResponseStatusRequest": {
        "required": [
          "status"
        ],
        "type": "object",
        "properties": {
          "status": {
            "minLength": 1,
            "pattern": "^(Accepted|Rejected)$",
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "tags": [
    {
      "name": "Auth"
    },
    {
      "name": "BloodRequests"
    },
    {
      "name": "Cities"
    },
    {
      "name": "Donor"
    }
  ]
}